<?php /* A feed as Atom 1.0. Every variable is escaped unless it is Html; a CDATA section takes Html escaped for it. */ ?>
<?= '<?xml version="1.0" encoding="utf-8"?>', "\n" ?>
<feed xmlns="http://www.w3.org/2005/Atom">
	<title type="html"><![CDATA[<?= $title ?>]]></title>
	<link rel="self" href="<?= $self ?>" />
	<updated><?= gmdate('Y-m-d\TH:i:s\Z', $built) ?></updated>
<?php if ($version !== null): ?>
	<generator version="<?= $version ?>">PunBB</generator>
<?php else: ?>
	<generator>PunBB</generator>
<?php endif ?>
<?= $info ?>
	<id><?= $link ?></id>
<?php $tag = $posts ? 'content' : 'summary' ?>
<?php foreach ($items as $item): ?>
		<entry>
			<title type="html"><![CDATA[<?= $item['title'] ?>]]></title>
			<link rel="alternate" href="<?= $item['link'] ?>" />
			<<?= $tag ?> type="html"><![CDATA[<?= $item['description'] ?>]]></<?= $tag ?>>
			<author>
				<name><![CDATA[<?= $item['name'] ?>]]></name>
<?php if ($item['email'] !== null): ?>
				<email><![CDATA[<?= $item['email'] ?>]]></email>
<?php endif ?>
<?php if ($item['uri'] !== null): ?>
				<uri><?= $item['uri'] ?></uri>
<?php endif ?>
			</author>
			<updated><?= gmdate('Y-m-d\TH:i:s\Z', $item['published']) ?></updated>
<?= $item['info'] ?>
			<id><?= $item['link'] ?></id>
		</entry>
<?php endforeach ?>
</feed>
