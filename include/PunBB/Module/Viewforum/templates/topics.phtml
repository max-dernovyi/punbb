<?php /* A forum's topics: the list with its options and summary, or the row saying there are none. Every variable is escaped unless it is Html. */ ?>
<?php if ($listed): ?>
	<div class="main-head">
<?php if ($headOptions !== null): ?>

		<p class="options"><?= $headOptions ?></p><?php endif ?>
		<h2 class="hn"><span><?= $itemsInfo ?></span></h2>
	</div>
	<div class="main-subhead">
		<p class="item-summary<?= $viewsClass ?>"><span><?= $summary ?></span></p>
	</div>
	<div id="forum<?= $id ?>" class="main-content main-forum<?= $viewsClass ?>">
<?= $before ?>
<?php foreach ($rows as $row): ?>
<?= $row['before'] ?>
		<div id="topic<?= $row['id'] ?>" class="main-item<?= $row['style'] ?>">
			<span class="icon <?= $row['status'] ?>"><!-- --></span>
			<div class="item-subject">
				<?= $row['subject'], "\n" ?>
			</div>
			<ul class="item-info">
				<?= $row['info'], "\n" ?>
			</ul>
		</div>
<?php endforeach ?>
	</div>
	<div class="main-foot">
<?php if ($footOptions !== null): ?>

			<p class="options"><?= $footOptions ?></p><?php endif ?>
		<h2 class="hn"><span><?= $itemsInfo ?></span></h2>
	</div>
<?php else: ?>
<?= $before ?>
	<div class="main-head">
<?php if ($headOptions !== null): ?>

		<p class="options"><?= $headOptions ?></p><?php endif ?>
		<h2 class="hn"><span><?= $empty ?></span></h2>
	</div>
	<div id="forum<?= $id ?>" class="main-content main-forum">
		<div class="main-item empty main-first-item">
			<span class="icon empty"><!-- --></span>
			<div class="item-subject">
				<?= $emptySubject, "\n" ?>
			</div>
		</div>
	</div>
	<div class="main-foot">
		<h2 class="hn"><span><?= $empty ?></span></h2>
	</div>
<?php endif ?>
