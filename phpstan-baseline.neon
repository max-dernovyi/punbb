parameters:
	ignoreErrors:
		-
			message: '#^Inner named functions are not supported by PHPStan\. Consider refactoring to an anonymous function, class method, or a top\-level\-defined function\. See issue \#165 \(https\://github\.com/phpstan/phpstan/issues/165\) for more details\.$#'
			identifier: function.inner
			count: 1
			path: include/common_admin.php

		-
			message: '#^Variable \$forum_page in empty\(\) is never defined\.$#'
			identifier: empty.variable
			count: 1
			path: include/common_admin.php

		-
			message: '#^Constructor of class DBLayer has an unused parameter \$foo\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: include/dblayer/mysqli.php

		-
			message: '#^Result of function mysqli_free_result \(void\) is used\.$#'
			identifier: function.void
			count: 1
			path: include/dblayer/mysqli.php

		-
			message: '#^Variable \$q_start might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: include/dblayer/mysqli.php

		-
			message: '#^Constructor of class DBLayer has an unused parameter \$foo\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: include/dblayer/mysqli_innodb.php

		-
			message: '#^Result of function mysqli_free_result \(void\) is used\.$#'
			identifier: function.void
			count: 1
			path: include/dblayer/mysqli_innodb.php

		-
			message: '#^Variable \$q_start might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: include/dblayer/mysqli_innodb.php

		-
			message: '#^Variable \$q_start might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: include/dblayer/pgsql.php

		-
			message: '#^Constructor of class DBLayer has an unused parameter \$db_host\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: include/dblayer/sqlite3.php

		-
			message: '#^Constructor of class DBLayer has an unused parameter \$db_password\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: include/dblayer/sqlite3.php

		-
			message: '#^Constructor of class DBLayer has an unused parameter \$db_username\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: include/dblayer/sqlite3.php

		-
			message: '#^Constructor of class DBLayer has an unused parameter \$p_connect\.$#'
			identifier: constructor.unusedParameter
			count: 1
			path: include/dblayer/sqlite3.php

		-
			message: '#^Variable \$q_start might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: include/dblayer/sqlite3.php

		-
			message: '#^Function _forum_remove_bad_characters not found\.$#'
			identifier: function.notFound
			count: 4
			path: include/functions.php

		-
			message: '#^Inner named functions are not supported by PHPStan\. Consider refactoring to an anonymous function, class method, or a top\-level\-defined function\. See issue \#165 \(https\://github\.com/phpstan/phpstan/issues/165\) for more details\.$#'
			identifier: function.inner
			count: 1
			path: include/functions.php

		-
			message: '#^Variable \$cookie_data in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: include/functions.php

		-
			message: '#^Variable \$pages in empty\(\) always exists and is always falsy\.$#'
			identifier: empty.variable
			count: 1
			path: include/functions.php

		-
			message: '#^Variable \$replace_callback might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: include/parser.php

		-
			message: '#^Variable \$cur_words might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: include/search_idx.php

		-
			message: '#^Undefined variable\: \$xml_array$#'
			identifier: variable.undefined
			count: 3
			path: include/xml.php

		-
			message: '#^Variable \$xml_array in isset\(\) is never defined\.$#'
			identifier: isset.variable
			count: 3
			path: include/xml.php
