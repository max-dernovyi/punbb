parameters:
	ignoreErrors:
		-
			message: '#^Inner named functions are not supported by PHPStan\. Consider refactoring to an anonymous function, class method, or a top\-level\-defined function\. See issue \#165 \(https\://github\.com/phpstan/phpstan/issues/165\) for more details\.$#'
			identifier: function.inner
			count: 1
			path: include/common_admin.php

		-
			message: '#^Result of function mysqli_free_result \(void\) is used\.$#'
			identifier: function.void
			count: 1
			path: include/dblayer/mysqli.php

		-
			message: '#^Result of function mysqli_free_result \(void\) is used\.$#'
			identifier: function.void
			count: 1
			path: include/dblayer/mysqli_innodb.php

		-
			message: '#^Function _csrf_confirm_form not found\.$#'
			identifier: function.notFound
			count: 3
			path: include/functions.php

		-
			message: '#^Function _forum_remove_bad_characters not found\.$#'
			identifier: function.notFound
			count: 4
			path: include/functions.php

