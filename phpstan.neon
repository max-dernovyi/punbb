includes:
	- phpstan-baseline.neon

parameters:
	level: 0
	paths:
		- admin
		- include
		- delete.php
		- edit.php
		- extern.php
		- footer.php
		- header.php
		- help.php
		- index.php
		- login.php
		- misc.php
		- moderate.php
		- post.php
		- profile.php
		- register.php
		- rewrite.php
		- search.php
		- userlist.php
		- viewforum.php
		- viewtopic.php
	excludePaths:
		analyseAndScan:
			- vendor
			- .dev/build
			- cache
			- extensions
			- include/js
	bootstrapFiles:
		- .dev/phpstan/bootstrap.php
	ignoreErrors:
		# cache/ is generated at runtime, so these paths exist or not depending on
		# whether the checkout happens to have an installed forum in it.
		-
			message: '#^Path in (require|include)\(\) "\./cache/cache_[^"]+" is not a file or it does not exist\.$#'
			reportUnmatched: false
