<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap=".dev/tests/UnitTests/TestHelper.php"
         colors="true"
         backupGlobals="false"
         cacheDirectory=".dev/build/phpunit"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true">

    <testsuites>
        <testsuite name="UnitTests">
            <directory>.dev/tests/UnitTests</directory>
        </testsuite>
    </testsuites>
</phpunit>
